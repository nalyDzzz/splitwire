{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splitwire",
  "mainBinaryName": "splitwire",
  "version": "0.2.0",
  "identifier": "dev.splitwire.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Splitwire",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Splitwire contributors",
    "category": "Utility",
    "shortDescription": "Per-app WireGuard split tunneling",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3N0UzRTAyNDRGQzk4RUIKUldUcm1QeEVBajUrMXdqZ2tWT3IvN2VjZDdRRlBOdEU5b1ZJM2ptK2Y0QWYzT3NhL3dCQjgxd0sK",
      "endpoints": ["https://github.com/nalyDzzz/splitwire/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
